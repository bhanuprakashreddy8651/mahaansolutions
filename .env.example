# Copy to .env.local. Never commit real secrets.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/mahaan?sslmode=require"
ADMIN_PASSWORD=""
# Generate a random secret of at least 32 characters, e.g. openssl rand -hex 32
ADMIN_SESSION_SECRET=""
RESEND_API_KEY=""
CONTACT_FROM_EMAIL=""
CONTACT_TO_EMAIL=""
NEXT_PUBLIC_SITE_URL=""
NEXT_PUBLIC_COMPANY_EMAIL=""
NEXT_PUBLIC_COMPANY_PHONE=""
# Enable only behind a trusted proxy that overwrites X-Forwarded-For.
TRUST_PROXY_IP="false"
